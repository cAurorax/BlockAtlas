<view class="page"><view wx:if="{{error}}" class="card">{{error}}<button bindtap="retry">重新加载</button></view><block wx:elif="{{player}}"><view class="card"><view class="row"><image src="/assets/player-{{portrait}}.png" style="width:86rpx;height:86rpx"/><view><view class="name">{{player.nickname}}</view><view class="muted">@{{player.username}}</view></view></view><button wx:if="{{canAct}}" bindtap="act" disabled="{{acting}}">{{label}}</button><view class="muted" wx:else>{{label}}</view></view><view class="name">发布的动态 · {{total}}</view><view class="card" wx:for="{{posts}}" wx:key="id" bindtap="detail" data-id="{{item.id}}"><view class="name">{{item.title}}</view><view class="muted">{{item.date}} · {{item.comment_count}} 条评论</view><image wx:if="{{item.media.length && item.media[0].kind==='image'}}" src="{{item.media[0].src}}" mode="aspectFill" style="width:100%;height:220rpx"/></view><view wx:if="{{!posts.length}}" class="muted">暂时没有可查看的动态。</view></block><view wx:if="{{busy}}" class="hint">正在读取…</view></view>
