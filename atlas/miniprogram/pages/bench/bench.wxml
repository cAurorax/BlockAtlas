<view class="page" wx:if="{{pack}}"><view class="eyebrow">MY LOADOUT</view><view class="title">我的整合包</view><view class="muted">{{pack.origin.label||"初始轻量生存包"}} · Fabric 1.20.1</view><view class="card" wx:for="{{rows}}" wx:key="slug"><view class="name">{{item.title}}</view><view class="muted">{{item.version}}</view><view class="row"><button class="small ghost" data-k="{{item.slug}}" data-op="{{item.locked?'unlock':'lock'}}" bindtap="act">{{item.locked?'解锁':'锁定'}}</button><button class="small ghost" data-k="{{item.slug}}" data-op="remove" bindtap="act">移除</button></view></view><view class="card"><view>最近改动：{{pack.last}}</view><button class="ghost small" data-op="undo" bindtap="act">撤销上一轮</button><button class="ghost small" bindtap="library">浏览资源库</button></view><view class="card"><view class="name">调整玩法 · {{pack.online?'在线模型':'离线指令'}}</view><view wx:for="{{pack.messages}}" wx:key="index"><view>你：{{item[0]}}</view><view>工坊：{{item[1]}}</view></view><input placeholder="加上配方查询，锁定性能优化" value="{{text}}" bindinput="input"/><button data-op="chat" bindtap="act" disabled="{{busy}}">应用修改</button></view><button bindtap="exportPack">生成最终包</button><view class="card" wx:if="{{code}}"><view>电脑取包码（24 小时有效）</view><view selectable>{{code}}</view><button bindtap="copy">复制取包码</button><view class="muted">在电脑浏览器打开服务地址下的 /pickup 输入此码。</view></view></view>
