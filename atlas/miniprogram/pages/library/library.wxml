<view class="page"><view class="eyebrow">MOD LIBRARY</view><view class="title">资源库</view><view class="card"><view class="name">从 Modrinth 导入</view><input placeholder="项目链接或 slug，如 lithium" data-key="link" value="{{link}}" disabled="{{busy}}" bindinput="input"/><button class="ghost" bindtap="lookup" disabled="{{busy}}">读取项目资料</button><view wx:if="{{found}}"><view>{{found.title}} · {{found.version}}</view><view>{{found.description}}</view><button data-op="import" bindtap="lookup" disabled="{{busy}}">确认入库</button></view></view><button class="small ghost" bindtap="only">{{savedOnly?"显示全部":"只看收藏"}}</button><input placeholder="搜索 Mod 名称" data-key="q" bindinput="input"/><view class="card" wx:for="{{shown}}" wx:key="slug"><view class="name">{{item.title}}</view><view class="muted">Fabric · {{item.version}}</view><view class="body">{{item.description}}</view><button class="small ghost" bindtap="add" data-slug="{{item.slug}}">加入我的草稿</button><button class="small ghost" data-slug="{{item.slug}}" bindtap="notes">实测 / 收藏</button><view wx:if="{{active===item.slug}}"><button bindtap="star">{{n.saved?"取消收藏":"收藏资源"}}</button><view wx:for="{{n.notes}}" wx:for-item="test" wx:key="nickname">{{test.nickname}} · {{test.version}} · {{test.result}}：{{test.note}}</view><picker range="{{outcomes}}" value="{{outcome}}" data-key="outcome" bindchange="input">{{outcomes[outcome]}}</picker><input placeholder="运行环境和实测表现" value="{{note}}" data-key="note" bindinput="input"/><button bindtap="submitNote">保存实测</button></view></view><view class="empty" wx:if="{{!shown.length}}">没有匹配的资源</view></view>
