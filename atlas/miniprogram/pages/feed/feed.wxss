page { background:#f7f8f2; }
.feed-page { padding:24rpx 30rpx 50rpx; }
.feed-heading,.utility-row,.stream-head,.cover-foot,.query-dates,.query-actions { display:flex; align-items:center; }
.feed-heading,.stream-head,.cover-foot { justify-content:space-between; gap:16rpx; }
.feed-heading { margin:6rpx 0 25rpx; }
.feed-heading .title { margin:0;font-size:48rpx;letter-spacing:-1rpx;color:#243d30; }
.publish-action { background:#2e533e;border-radius:12rpx;font-size:25rpx;line-height:68rpx;padding:0 23rpx; }
.lens-cover { width:100%; padding:28rpx 32rpx; text-align:left; color:white; background-size:cover; background-position:center 55%; border-radius:15rpx; line-height:1.5; }
.cover-note { display:flex; align-items:center;gap:13rpx;font-size:22rpx;font-weight:500;color:#e1edce; }
.pixel { width:13rpx;height:13rpx;background:#c7de89;box-shadow:0 4rpx 0 #7d9a65; }
.cover-title { margin:14rpx 0 20rpx;font-weight:700;font-size:38rpx; }
.cover-foot { font-size:22rpx;font-weight:400;color:#e3e8dc; }
.arrow { font-size:30rpx;line-height:1; }
.utility-row { gap:14rpx;margin:16rpx 0 32rpx; }
.utility { padding:0 23rpx; font-size:24rpx;line-height:64rpx;color:#425844;background:#edf1e6;border-radius:12rpx; }
.stream-head { margin-bottom:18rpx;border-bottom:1rpx solid #dbe1d4; }
.stream-tabs { gap:18rpx;margin:0; }
.stream-tabs button { position:relative; margin:0; padding:0 6rpx; line-height:76rpx;border-radius:0; color:#6b776b;background:transparent;font-size:27rpx; }
.stream-tabs .picked { color:#264632;font-weight:700; }
.stream-tabs .picked::before { content:"";position:absolute;bottom:0;left:20%;right:20%;height:5rpx;background:#517846; }
.filter-trigger { color:#566c56;background:transparent;font-size:23rpx;line-height:64rpx;padding:0 3rpx; }
.filtered { color:#2e5630;font-weight:700; }
.query-sheet { background:#f0f3e9; padding:20rpx; border-radius:14rpx; margin-bottom:22rpx; }
.query-sheet input,.query-sheet picker { height:auto; line-height:1.6; margin-bottom:14rpx; padding:14rpx 16rpx; font-size:25rpx; }
.query-dates { gap:10rpx;color:#657666; }
.query-dates picker { flex:1; }
.query-actions { justify-content:flex-end;gap:14rpx; }
.feed-page .card { border-radius:16rpx; border-color:#dce2d6; margin-bottom:18rpx; }
.feed-page .muted,.feed-page .hint { color:#667568; }
.feed-page .avatar { width:66rpx;height:66rpx;border-radius:13rpx;font-size:28rpx; }
.feed-page .body { margin:18rpx 0;line-height:1.75; }
.feed-page .tag { color:#526d50; }
@media (prefers-reduced-motion: no-preference) {
  .query-sheet { animation:filter-enter 150ms ease-out both; }
  .utility,.publish-action,.lens-cover { transition:opacity 120ms; }
  .utility:active,.publish-action:active,.lens-cover:active { opacity:.85; }
  @keyframes filter-enter { from {opacity:0;transform:translateY(-5rpx);} to {opacity:1;transform:translateY(0);} }
}

.feed-heading .profile-avatar{margin:0 0 0 auto;padding:0;width:62rpx;height:62rpx;line-height:62rpx;background:#e1e9d9;color:#36563c;border-radius:12rpx}.utility-row{flex-wrap:wrap}

.feed-page{padding-bottom:calc(130rpx + env(safe-area-inset-bottom))}
.mini-dock{position:fixed;left:20rpx;bottom:calc(16rpx + env(safe-area-inset-bottom));z-index:12}
.mini-avatar{padding:0;width:82rpx;height:82rpx;display:flex;justify-content:center;align-items:center;background:#c6d8af;border:3rpx solid #819d78;border-radius:10rpx}.mini-avatar image{width:70rpx;height:70rpx}
.mini-pouch{position:absolute;bottom:94rpx;left:0;width:290rpx;padding:12rpx;background:#fcf9ef;border:2rpx solid #b8b69a;border-radius:12rpx;box-shadow:0 6rpx 22rpx #19291f33}
.pouch-caption{display:flex;align-items:center;gap:10rpx;font-size:24rpx;color:#675238;border-bottom:1rpx solid #dfddcd;padding:6rpx 10rpx}.pouch-caption image{width:42rpx;height:42rpx}.mini-pouch button{display:block;margin:0;width:100%;color:#314635;text-align:left;border:none;background:transparent;font-size:28rpx}.mini-pouch button:last-child{color:#815640}
.pouch-shade{position:fixed;inset:0;background:transparent}.mini-avatar{position:relative}
