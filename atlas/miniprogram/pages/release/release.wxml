<view class="page" wx:if="{{v}}"><view class="eyebrow">PACK RELEASE / v{{v.revision}}</view><view class="title">{{v.title}}</view><picker range="{{v.versions}}" range-key="rev" bindchange="version">选择历史版本 · 当前 v{{v.revision}}</picker><view class="card"><view wx:for="{{v.mods}}" wx:key="slug">{{item.title}} · {{item.version}}</view><button bindtap="derive">基于这一版修改</button></view><view class="name">版本实测墙</view><view class="card" wx:for="{{v.trials}}" wx:key="nickname"><view>{{item.nickname}} · {{item.outcome}}</view><view>{{item.note}}</view><block wx:for="{{item.media}}" wx:for-item="m" wx:key="id"><image wx:if="{{m.kind==='image'}}" src="{{m.src}}" mode="widthFix"/><video wx:else src="{{m.src}}" controls/></block></view><view class="card"><picker range="{{choices}}" data-key="idx" bindchange="input">{{choices[idx]}}</picker><textarea placeholder="记录环境与测试结果" data-key="note" value="{{note}}" bindinput="input"/><input placeholder="我的公开媒体帖编号（选填）" type="number" data-key="evidence" value="{{evidence}}" bindinput="input"/><button disabled="{{busy}}" bindtap="submit">保存本版实测</button></view></view>
