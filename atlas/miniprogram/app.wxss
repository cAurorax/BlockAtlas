page {
  background: #f5f5ef;
  color: #243f34;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
view,
input,
textarea,
button {
  box-sizing: border-box;
}
button {
  background: #235e50;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.6;
  margin: 0;
}
button::after {
  border: 0;
}
button.ghost {
  background: #edf2e9;
  color: #57775c;
}
button.danger {
  background: #fff0e9;
  color: #ad6048;
}
button.small {
  font-size: 23rpx;
  padding: 0 20rpx;
  line-height: 2.6;
}
input,
textarea,
picker {
  background: #fff;
  border: 1rpx solid #e0e6dc;
  border-radius: 14rpx;
  padding: 22rpx;
  width: 100%;
  font-size: 27rpx;
}
textarea {
  height: 230rpx;
  line-height: 1.8;
}
.page {
  padding: 30rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 16rpx 0;
}
.eyebrow {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: #8a9a87;
}
.sub {
  color: #8a9788;
  font-size: 25rpx;
  line-height: 1.9;
  margin-bottom: 30rpx;
}
.card {
  padding: 30rpx;
  background: white;
  border: 1rpx solid #e4e9df;
  border-radius: 24rpx;
  margin-bottom: 25rpx;
}
.row {
  display: flex;
  gap: 18rpx;
  align-items: center;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.avatar {
  width: 76rpx;
  height: 76rpx;
  background: #e5efdf;
  color: #376e4b;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}
.muted {
  color: #8c9a88;
  font-size: 22rpx;
}
.name {
  font-weight: 600;
  margin-bottom: 7rpx;
}
.body {
  white-space: pre-wrap;
  line-height: 1.9;
  margin: 25rpx 0;
  word-break: break-all;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0;
}
.tag {
  font-size: 22rpx;
  background: #f0f4e9;
  color: #799070;
  border-radius: 8rpx;
  padding: 7rpx 15rpx;
}
.media {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.media image {
  width: 185rpx;
  height: 185rpx;
  border-radius: 12rpx;
}
.media.one image {
  width: 100%;
  height: 360rpx;
}
.media video {
  width: 100%;
  border-radius: 12rpx;
}
.footer {
  border-top: 1rpx solid #edf0e9;
  margin-top: 23rpx;
  padding-top: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #728369;
  margin: 24rpx 0 12rpx;
}
.space {
  margin-top: 24rpx;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
}
.tabs button {
  flex: 1;
}
.empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #8e9b87;
  line-height: 2;
}
.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #e5edda;
  margin-bottom: 25rpx;
}
.hero .title {
  font-size: 38rpx;
}
.filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 15rpx;
}
.filter input,
.filter picker {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  padding: 15rpx;
}
.bottom {
  display: flex;
  gap: 15rpx;
  margin-top: 25rpx;
}
.bottom button {
  flex: 1;
}
.tag button {
  display: inline-block;
  background: none;
  color: #829578;
  padding: 0 8rpx;
  line-height: 1.3;
}
.preview {
  position: relative;
}
.preview button {
  position: absolute;
  right: 0;
  top: 0;
  padding: 0 16rpx;
}
.badge {
  color: #a37d4c;
  background: #f8f3e8;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}
.comment {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e7ecdf;
}
.comment .body {
  font-size: 26rpx;
  margin: 14rpx 0;
}
.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.hint {
  font-size: 22rpx;
  color: #8c9c85;
  line-height: 1.8;
  margin: 16rpx 0;
}
.login-logo {
  margin-top: 80rpx;
  font-size: 64rpx;
  font-weight: 700;
}
.switch {
  text-align: center;
  padding: 25rpx;
  color: #598162;
}
.link {
  color: #497951;
}

.mc-hero{background-size:cover;background-position:center;color:#fff}.mc-hero .muted{color:#eee}